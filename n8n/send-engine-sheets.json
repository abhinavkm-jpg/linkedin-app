    "Invite or message?": { "main": [ [ { "node": "Unipile: send invite", "type": "main", "index": 0 } ], [ { "node": "Unipile: start chat / DM", "type": "main", "index": 0 } ] ] },
    "Unipile: send invite": { "main": [ [ { "node": "Shape lead update", "type": "main", "index": 0 } ] ] },
